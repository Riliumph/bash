// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/docker-existing-docker-compose
{
	"name": "Bash",
	"build": {
		"dockerfile": "Dockerfile",
		"args": {
			"HADOLINT_URL": "https://github.com/hadolint/hadolint/releases/download/v2.12.0/hadolint-Linux-x86_64"
		}
	},
	"runArgs": [
		"--hostname",
		"dev-container"
	],
	"mounts": [
		"source=${localEnv:HOME}/.gitconfig,target=/home/vscode/.gitconfig,type=bind"
	],
	"workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
	// ${containerWorkspaceFolder}でworkspaceFolderを参照できるらしい。バグの可能性もあるので、workspaceFolderと同じ書式の方が良いかもしれない
	"workspaceMount": "source=${localWorkspaceFolder},target=${containerWorkspaceFolder},type=bind",
	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},
	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],
	// Uncomment the next line if you want start specific services in your Docker Compose config.
	// "runServices": [],
	// Uncomment the next line if you want to keep your containers running after VS Code shuts down.
	// "shutdownAction": "none",
	// Uncomment the next line to run commands after the container is created.
	// "initializeCommand": "",
	// "onCreateCommand": "",
	// "updateContentCommand": "",
	// "postCreateCommand": "cat /etc/os-release",
	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-azuretools.vscode-docker",
				"exiasr.hadolint",
				"DavidAnson.vscode-markdownlint",
				"streetsidesoftware.code-spell-checker",
				"EditorConfig.EditorConfig", // read editoconfig for shell
				"timonwong.shellcheck", // automatically exe shellcheck
				"mkhl.shfmt", // automatically exe shfmt
				"shardulm94.trailing-spaces",
				"IBM.output-colorizer",
				"emilast.LogFileHighlighter"
			]
		}
	}
	// Uncomment to connect as an existing user other than the container default. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "devcontainer"
}
