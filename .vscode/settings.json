{
  "[shellscript]": {
    "editor.defaultFormatter": "mkhl.shfmt",
    "editor.formatOnSave": true
  },
  "shellcheck.exclude": [
    "SC1090",
    "SC1091",
    "SC2016"
  ],
  "shellformat.useEditorConfig": true,
  "shellformat.effectLanguages": [
    "shellscript"
  ],
  "cSpell.words": [
    "COLORRC",
    "CONFD",
    "dircolors",
    "shelloption",
    "stty"
  ]
}
